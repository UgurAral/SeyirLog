rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Her kullanıcı yalnızca kendi users/{uid}/... alt koleksiyonlarına
    // (vehicles, trips, fuel_entries, expenses, income_entries) erişebilir.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Anonim talep sinyali (Faz 2 ısı haritası için veri toplama).
    // Kullanıcı kimliği taşımaz; istemciler sadece yeni kayıt oluşturabilir,
    // okuyamaz/değiştiremez/silemez — toplu okuma/analiz sunucu tarafında yapılır.
    match /demand_signals/{signalId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'date', 'hour', 'dayOfWeek', 'createdAt'])
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.hour is number
        && request.resource.data.dayOfWeek is number;
      allow read, update, delete: if false;
    }
  }
}
